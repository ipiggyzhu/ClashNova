{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ClashNova 主窗口默认能力: core 基础权限 + mihomo sidecar + 自启 + 外部打开",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mihomo",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "autostart:default",
    "opener:default",
    "process:default",
    "log:default"
  ]
}
