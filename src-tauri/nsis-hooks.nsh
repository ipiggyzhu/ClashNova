!macro CLASHNOVA_STOP_INSTALLED_PROCESSES
  DetailPrint "Stopping running ClashNova processes..."
  nsExec::ExecToLog `powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $$ErrorActionPreference = 'SilentlyContinue'; $$installRoot = [System.IO.Path]::GetFullPath('$INSTDIR').TrimEnd([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar); $$installDir = $$installRoot + [System.IO.Path]::DirectorySeparatorChar; $$targetNames = @('ClashNova.exe', 'clashnova.exe', 'clashnova-service.exe', 'clashnova-service-install.exe', 'clashnova-service-uninstall.exe', 'mihomo.exe', 'mihomo-x86_64-pc-windows-msvc.exe'); $$helpers = @((Join-Path $$installRoot 'helpers\clashnova-service-uninstall.exe'), (Join-Path $$installRoot 'resources\clashnova-service-uninstall.exe'), (Join-Path $$installRoot 'clashnova-service-uninstall.exe')); foreach($$helper in $$helpers) { if(Test-Path $$helper) { Start-Process -FilePath $$helper -Wait -WindowStyle Hidden; break } }; $$svc = Get-Service -Name 'clashnova-core' -ErrorAction SilentlyContinue; if($$svc -and $$svc.Status -ne 'Stopped') { Stop-Service -Name 'clashnova-core' -Force -ErrorAction SilentlyContinue }; & sc.exe stop clashnova-core | Out-Null; & sc.exe delete clashnova-core | Out-Null; function Get-TreeIds($$roots) { $$all = @(Get-CimInstance Win32_Process); $$ids = @(); $$queue = @($$roots | Where-Object { $$_ -and $$_ -ne 0 }); while($$queue.Count -gt 0) { $$id = [int]$$queue[0]; if($$queue.Count -gt 1) { $$queue = @($$queue[1..($$queue.Count - 1)]) } else { $$queue = @() }; if($$ids -contains $$id) { continue }; $$ids += $$id; $$queue += @($$all | Where-Object { $$_.ParentProcessId -eq $$id } | Select-Object -ExpandProperty ProcessId) }; $$ids }; for($$i = 0; $$i -lt 80; $$i++) { $$all = @(Get-CimInstance Win32_Process); $$svcInfo = Get-CimInstance Win32_Service | Where-Object { $$_.Name -eq 'clashnova-core' }; $$svcRoots = @(); if($$svcInfo -and $$svcInfo.ProcessId) { $$svcRoots += $$svcInfo.ProcessId }; $$roots = @($$svcRoots); $$roots += @($$all | Where-Object { $$name = $$_.Name; $$path = $$_.ExecutablePath; $$cmd = $$_.CommandLine; $$isTarget = $$targetNames.Contains($$name); $$pathMatch = $$path -and ([System.IO.Path]::GetFullPath($$path)).StartsWith($$installDir, [System.StringComparison]::OrdinalIgnoreCase); $$cmdMatch = $$cmd -and ($$cmd.IndexOf($$installDir, [System.StringComparison]::OrdinalIgnoreCase) -ge 0); $$clashName = $$name -match '(?i)^clashnova'; $$isTarget -and ($$pathMatch -or $$cmdMatch -or $$clashName) } | Select-Object -ExpandProperty ProcessId); $$treeIds = Get-TreeIds $$roots; $$svc = Get-Service -Name 'clashnova-core' -ErrorAction SilentlyContinue; if($$svc -and $$svc.Status -ne 'Stopped' -and $$i -eq 0) { Stop-Service -Name 'clashnova-core' -Force -ErrorAction SilentlyContinue }; $$procs = @($$all | Where-Object { $$name = $$_.Name; $$path = $$_.ExecutablePath; $$cmd = $$_.CommandLine; $$isTarget = $$targetNames.Contains($$name); $$pathMatch = $$path -and ([System.IO.Path]::GetFullPath($$path)).StartsWith($$installDir, [System.StringComparison]::OrdinalIgnoreCase); $$cmdMatch = $$cmd -and ($$cmd.IndexOf($$installDir, [System.StringComparison]::OrdinalIgnoreCase) -ge 0); $$treeMatch = $$treeIds -contains $$_.ProcessId; $$clashName = $$name -match '(?i)^clashnova'; $$treeMatch -or ($$isTarget -and ($$pathMatch -or $$cmdMatch -or $$clashName)) }); if($$procs.Count -eq 0 -and (-not $$svc -or $$svc.Status -eq 'Stopped')) { break }; $$procs | ForEach-Object { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }; Start-Sleep -Milliseconds 250 } }"`
  Sleep 1600
!macroend

!macro NSIS_HOOK_PREINSTALL
  !insertmacro CLASHNOVA_STOP_INSTALLED_PROCESSES
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro CLASHNOVA_STOP_INSTALLED_PROCESSES
!macroend
