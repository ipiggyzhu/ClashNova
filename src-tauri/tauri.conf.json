{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClashNova",
  "version": "2.4.0",
  "identifier": "io.clashnova.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClashNova",
        "width": 1120,
        "height": 716,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/mihomo"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$script = @('scripts/sign-windows.ps1', '../scripts/sign-windows.ps1', 'src-tauri/scripts/sign-windows.ps1') | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1; if (!$script) { throw 'scripts/sign-windows.ps1 was not found' }; & $script $args[0]",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
